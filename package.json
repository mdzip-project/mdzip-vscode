{
  "name": "mdzip-vscode",
  "displayName": "MDZip Editor",
  "description": "Edit MDZip (.mdz) files in single document mode — Markdown plus its images in one portable file — with live preview. Also opens plain Markdown (.md) files in the same editor via Open With.",
  "version": "1.3.88",
  "icon": "media/icons/mdzip-marketplace-icon.png",
  "publisher": "mdzip-project",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdzip-project/mdzip-vscode"
  },
  "bugs": {
    "url": "https://github.com/mdzip-project/mdzip-vscode/issues"
  },
  "homepage": "https://github.com/mdzip-project/mdzip-vscode#readme",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "AI",
    "Chat"
  ],
  "keywords": [
    "mdzip",
    "mdz",
    "markdown",
    "zip",
    "document"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "mdzip-logo": {
        "description": "MDZip",
        "default": {
          "fontPath": "./media/icons/mdzip-icons.woff",
          "fontCharacter": "\\E900"
        }
      },
      "mdzip-logo-open": {
        "description": "MDZip (open folder)",
        "default": {
          "fontPath": "./media/icons/mdzip-icons.woff",
          "fontCharacter": "\\E901"
        }
      },
      "mdzip-markdown": {
        "description": "Markdown",
        "default": {
          "fontPath": "./media/icons/mdzip-icons.woff",
          "fontCharacter": "\\E902"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "mdzip.bundled-mcp",
        "label": "MDZip MCP Server"
      }
    ],
    "languageModelTools": [
      {
        "name": "mdzip_review_document",
        "displayName": "Review MDZip Document",
        "modelDescription": "Preferred first call for review/analyze/summarize requests on an .mdz file. Returns markdown text and referenced images plus canonical/entrypoint resolution metadata, including canonicalContentHash — pass that back as expectedContentHash to mdzip_upsert_canonical_document to guard against overwriting edits made elsewhere since this read.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mdzReviewDocument",
        "icon": "$(book)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            },
            "entryPath": {
              "type": "string",
              "description": "Optional archive-relative markdown path. When omitted, resolves manifest-first canonical markdown."
            },
            "maxImages": {
              "type": "number",
              "description": "Optional cap for returned images. Defaults to 12, clamped to 1..50."
            }
          },
          "required": ["archivePath"]
        }
      },
      {
        "name": "mdzip_list_entries",
        "displayName": "List MDZip Entries",
        "modelDescription": "List all non-directory entries inside an .mdz archive. Advanced inspection tool; prefer mdzip_review_document for default review workflows.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mdzListEntries",
        "icon": "$(list-tree)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            }
          },
          "required": ["archivePath"]
        }
      },
      {
        "name": "mdzip_search_text",
        "displayName": "Search MDZip Text",
        "modelDescription": "Search UTF-8 text entries inside an .mdz archive. Use this directly for grep/find/search requests.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mdzSearchText",
        "icon": "$(search)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            },
            "query": {
              "type": "string",
              "description": "Text or regular expression to search for inside archive text entries."
            },
            "caseSensitive": {
              "type": "boolean",
              "description": "Whether matching is case-sensitive. Defaults to false."
            },
            "regex": {
              "type": "boolean",
              "description": "Interpret query as a JavaScript regular expression. Defaults to false."
            },
            "maxResults": {
              "type": "number",
              "description": "Maximum number of matching lines to return. Defaults to 100, clamped to 1..1000."
            }
          },
          "required": ["archivePath", "query"]
        }
      },
      {
        "name": "mdzip_read_text",
        "displayName": "Read MDZip Text Entry",
        "modelDescription": "Read a UTF-8 text entry from an .mdz archive by archive-relative path. Advanced inspection tool; prefer mdzip_review_document for first read.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mdzReadText",
        "icon": "$(file-text)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            },
            "entryPath": {
              "type": "string",
              "description": "Archive-relative path (for example: manifest.json or index.md)."
            }
          },
          "required": ["archivePath", "entryPath"]
        }
      },
      {
        "name": "mdzip_read_image",
        "displayName": "Read MDZip Image",
        "modelDescription": "Read an image entry from an .mdz archive and return it directly as image content (no extraction required). Advanced inspection tool.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mdzReadImage",
        "icon": "$(file-media)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            },
            "entryPath": {
              "type": "string",
              "description": "Archive-relative image path (for example: images/diagram.png)."
            }
          },
          "required": ["archivePath", "entryPath"]
        }
      },
      {
        "name": "mdzip_read_markdown_embedded_images",
        "displayName": "Read MDZip Markdown with Embedded Images",
        "modelDescription": "Read markdown from an .mdz entry and embed archive images as data URLs directly in the markdown text. Prefer mdzip_review_document for general review tasks.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "mdzReadMarkdownEmbeddedImages",
        "icon": "$(preview)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            },
            "entryPath": {
              "type": "string",
              "description": "Optional archive-relative markdown path. When omitted, resolves manifest-first canonical markdown."
            }
          },
          "required": ["archivePath"]
        }
      },
      {
        "name": "mdzip_upsert_canonical_document",
        "displayName": "Update MDZip Canonical Document",
        "modelDescription": "Write path for markdown updates. Updates manifest-first canonical markdown and returns changed paths plus post-write validation. Requires expectedContentHash (from a prior mdzip_review_document call) and fails with a CONTENT_CONFLICT error instead of overwriting if the on-disk canonical content has changed since that read.",
        "canBeReferencedInPrompt": false,
        "toolReferenceName": "mdzUpsertCanonicalDocument",
        "icon": "$(save)",
        "tags": ["mdzip", "mdz"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to the .mdz file."
            },
            "content": {
              "type": "string",
              "description": "New markdown content for the canonical entrypoint document."
            },
            "expectedContentHash": {
              "type": "string",
              "description": "The canonicalContentHash returned by the most recent mdzip_review_document call for this archive."
            }
          },
          "required": ["archivePath", "content", "expectedContentHash"]
        }
      }
    ],
    "languages": [
      {
        "id": "mdzip",
        "extensions": [
          ".mdz"
        ],
        "icon": {
          "light": "media/icons/mdzip-explorer-icon.svg",
          "dark": "media/icons/mdzip-explorer-icon.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "mdzip.mdzEditor",
        "displayName": "MDZip",
        "selector": [
          {
            "filenamePattern": "*.mdz"
          },
          {
            "filenamePattern": "*.mdz.zip"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mdzip.mdEditor",
        "displayName": "Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdzip.newFile",
        "title": "MDZip: New .mdz file...",
        "icon": {
          "light": "media/icons/mdzip-explorer-icon.svg",
          "dark": "media/icons/mdzip-explorer-icon.svg"
        }
      },
      {
        "command": "mdzip.configureTemplateFolder",
        "title": "MDZip: Configure Template Folder"
      },
      {
        "command": "mdzip.openTemplatesFolder",
        "title": "MDZip: Open Templates Folder"
      },
      {
        "command": "mdzip.convertMarkdownToMdz",
        "title": "MDZip: Convert .md To .mdz",
        "icon": {
          "light": "media/icons/mdzip-explorer-icon.svg",
          "dark": "media/icons/mdzip-explorer-icon.svg"
        }
      },
      {
        "command": "mdzip.compareMarkdown",
        "title": "MDZip: Compare Markdown"
      },
      {
        "command": "mdzip.compareWithGitBase",
        "title": "MDZip: Compare Document Markdown with Git Base"
      },
      {
        "command": "mdzip.compareArchiveWithGitBase",
        "title": "MDZip: Compare Archive Contents with Git Base"
      },
      {
        "command": "mdzip.copyMcpConfigSnippet",
        "title": "MDZip: Copy MCP Server Config Snippet"
      },
      {
        "command": "mdzip.enableWorkspaceMcp",
        "title": "MDZip: Enable Workspace MCP Server"
      },
      {
        "command": "mdzip.enableUserMcp",
        "title": "MDZip: Enable User MCP Server"
      },
      {
        "command": "mdzip.enableCodexMcp",
        "title": "MDZip: Enable Codex MCP Server"
      },
      {
        "command": "mdzip.enableClaudeMcp",
        "title": "MDZip: Enable Claude Code MCP Server (Workspace)"
      },
      {
        "command": "mdzip.enableClaudeUserMcp",
        "title": "MDZip: Enable Claude Code MCP Server (User)"
      },
      {
        "command": "mdzip.copyClaudeMcpConfigSnippet",
        "title": "MDZip: Copy Claude Code MCP Server Config Snippet"
      },
      {
        "command": "mdzip.openGettingStarted",
        "title": "MDZip: Open Getting Started"
      },
      {
        "command": "mdzip.openMcpServerStatus",
        "title": "MDZip: Open MCP Server Status"
      },
      {
        "command": "mdzip.openExtensionHelp",
        "title": "MDZip: Open Extension Help"
      },
      {
        "command": "mdzip.openDocumentation",
        "title": "MDZip: Open Documentation"
