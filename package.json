          "when": "resourceExtname == .mdz",
          "group": "1_mdzip@16"
        },
        {
          "command": "mdzip.convertFolderToMdz",
          "when": "explorerResourceIsFolder",
          "group": "1_mdzip@17"
        }
      ],
      "editor/title": [
